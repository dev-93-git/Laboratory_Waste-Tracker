class PieChart(tk.Canvas if HAVE_TK else object):
    """Pie chart of record counts by waste category, with a legend underneath.

    Slices use the category color code. The legend gives every category's exact
    count and share, so small or similar slices can still be read precisely, and
    hovering a slice shows its details."""

    TITLE_H = 58  # room above the pie for the title and the hover hint
    PAD = 16

    def __init__(self, parent, title, status, empty_text):
        super().__init__(parent, bg=SURFACE, bd=0, highlightthickness=1,
                         highlightbackground=BORDER, width=240, height=320)
        self.title, self.status, self.empty_text = title, status, empty_text
        self.counts, self.hint, self.base_hint = [], None, ""
        self.f_title, self.f_label, self.f_small = (
            APP_FONTS["title"], APP_FONTS["label"], APP_FONTS["small"])
        self.bind("<Configure>", lambda _e: self.redraw())

    def retheme(self):
        self.configure(bg=SURFACE, highlightbackground=BORDER)
        self.redraw()

    def set_entries(self, entries):
        self.counts = category_counts(entries, self.status)
        self.redraw()

    def _fit(self, text, max_px):
        """Shorten text with an ellipsis so it fits in max_px."""
        if self.f_small.measure(text) <= max_px:
            return text
        while text and self.f_small.measure(text + "…") > max_px:
            text = text[:-1]
        return text + "…"

    def redraw(self):
        self.delete("all")
        w, h = self.winfo_width(), self.winfo_height()
        if w < 80 or h < 120:
            return
        pad = self.PAD
        slices = pie_slices(self.counts)
        total = sum(s[1] for s in slices)
        self.base_hint = f"{total} record{'s' if total != 1 else ''}"
        self.create_text(pad, 22, text=self.title, anchor="w", font=self.f_title, fill=TEXT)
        self.hint = self.create_text(pad, 44, text=self.base_hint, anchor="w",
                                     font=self.f_small, fill=MUTED)
        if not slices:
            self.create_text(w / 2, h / 2, text=self.empty_text, font=self.f_small, fill=MUTED)
            return

        # Size the pie to whatever space is left after the legend
        row_h = 20
        d = min(w - 2 * pad, h - self.TITLE_H - len(slices) * row_h - 2 * pad)
        if d < 90:  # tight on space: compact legend rows
            row_h = 15
            d = min(w - 2 * pad, h - self.TITLE_H - len(slices) * row_h - 2 * pad)
        d = max(d, 60)
        x0, y0 = (w - d) / 2, self.TITLE_H
        r = d / 2
        cx, cy = x0 + r, y0 + r

        for i, (cat, n, pct, start, extent) in enumerate(slices):
            color = CATEGORY_COLORS.get(cat, DEFAULT_CATEGORY_COLOR)
            tag = f"slice{i}"
            if len(slices) == 1:  # Tk draws nothing for a 360-degree arc, so use a circle
                self.create_oval(x0, y0, x0 + d, y0 + d, fill=color, outline=SURFACE,
                                 width=2, tags=(tag,))
            else:  # Tk angles run counter-clockwise from 3 o'clock; ours run clockwise from 12
                self.create_arc(x0, y0, x0 + d, y0 + d, start=90 - start, extent=-extent,
                                fill=color, outline=SURFACE, width=2, style="pieslice",
                                tags=(tag,))
            detail = self._fit(f"{cat}: {n} record{'s' if n != 1 else ''} ({pct:.1f}%)", w - 2 * pad)
            self.tag_bind(tag, "<Enter>", lambda _e, t=detail: self.itemconfigure(self.hint, text=t))
            self.tag_bind(tag, "<Leave>", lambda _e: self.itemconfigure(self.hint, text=self.base_hint))
            if pct >= 7 and d >= 110:  # percentage inside slices big enough to hold it
                if len(slices) == 1:
                    lx, ly = cx, cy
                else:
                    mid = math.radians(90 - start - extent / 2)
                    lx, ly = cx + 0.66 * r * math.cos(mid), cy - 0.66 * r * math.sin(mid)
                self.create_text(lx, ly, text=f"{pct:.0f}%", font=self.f_label,
                                 fill=readable_text(color), tags=(tag,))

        # Legend: color swatch, category, exact count and share
        ly = y0 + d + pad
        for cat, n, pct, _start, _extent in slices:
            color = CATEGORY_COLORS.get(cat, DEFAULT_CATEGORY_COLOR)
            mid_y = ly + row_h / 2
            self.create_rectangle(pad, mid_y - 5, pad + 10, mid_y + 5, fill=color, outline="")
            value = f"{n} · {pct:.1f}%"
            self.create_text(w - pad, mid_y, text=value, anchor="e", font=self.f_small, fill=TEXT)
            room = w - 2 * pad - 16 - self.f_small.measure(value) - 8
            self.create_text(pad + 16, mid_y, text=self._fit(cat, room), anchor="w",
                             font=self.f_small, fill=TEXT)
            ly += row_h


def fit_text(font, text, max_px):
    """Shorten text with an ellipsis so it fits in max_px (font is a tkfont.Font)."""
    if font.measure(text) <= max_px:
        return text
    while text and font.measure(text + "…") > max_px:
        text = text[:-1]
    return text + "…"


class LineChart(tk.Canvas if HAVE_TK else object):
    """Line graph of running waste totals over time for one waste group (hazardous or
    non-hazardous) and one status (total, awaiting disposal or disposed), with one
    line per waste category in that group.

    Lines use the category color code and dots mark the days a category changed.
    Hovering a dot shows its category, date and amount at the top right."""

    PAD, LEFT, RIGHT, TOP, BOTTOM = 16, 56, 22, 38, 28

    def __init__(self, parent, title, status, group):
        super().__init__(parent, bg=SURFACE, bd=0, highlightthickness=1,
                         highlightbackground=BORDER, height=110)
        self.title, self.status, self.group = title, status, group
        self.measure, self.dates, self.series = None, [], []
        self.hint, self.base_hint = None, ""
        self.f_title, self.f_small = APP_FONTS["title"], APP_FONTS["small"]
        self.bind("<Configure>", lambda _e: self.redraw())

    def retheme(self):
        self.configure(bg=SURFACE, highlightbackground=BORDER)
        self.redraw()

    def set_data(self, entries, measure):
        self.measure = measure
        self.dates, self.series = waste_timeline(entries, measure, self.status, self.group)
        self.redraw()

    def redraw(self):
        self.delete("all")
        w, h = self.winfo_width(), self.winfo_height()
        if self.measure is None or w < 240 or h < 100:
            return
        noun, unit, _factors = MEASURES[self.measure]
        pad = self.PAD
        self.create_text(pad, 18, text=self.title, anchor="w", font=self.f_title, fill=TEXT)
        total = sum(points[-1][1] for _cat, points in self.series)
        self.base_hint = f"Total {total:g} {unit}" if self.series else ""
        self.hint_room = w - 2 * pad - self.f_title.measure(self.title) - 16
        self.hint = self.create_text(w - pad, 18, text=fit_text(self.f_small, self.base_hint, self.hint_room),
                                     anchor="e", font=self.f_small, fill=MUTED)
        if not self.series:
            self.create_text(w / 2, h / 2 + 8,
                             text=LINE_EMPTY[self.status].format(noun=noun, group=self.group.lower()),
                             font=self.f_small, fill=MUTED)
            return

        x0, x1 = self.LEFT, w - self.RIGHT
        y0, y1 = self.TOP, h - self.BOTTOM
        ticks = nice_ticks(max(v for _cat, pts in self.series for _d, v, _e in pts))
        top = ticks[-1]

        def ypos(value):
            return y1 - (value / top) * (y1 - y0) if top else y1

        for t in ticks:  # light grid + value labels
            self.create_line(x0, ypos(t), x1, ypos(t), fill=BORDER, width=1)
            self.create_text(x0 - 8, ypos(t), text=f"{t:g}", anchor="e", font=self.f_small, fill=MUTED)
        self.create_text(x0 - 8, y0 - 14, text=unit, anchor="e", font=self.f_small, fill=MUTED)

        first, last = self.dates[0].toordinal(), self.dates[-1].toordinal()
        span = last - first

        def xpos(day):
            return (x0 + x1) / 2 if span == 0 else x0 + (day.toordinal() - first) / span * (x1 - x0)

        # Date labels along the bottom
        count = 1 if span == 0 else min(span + 1, max(2, int((x1 - x0) / 110) + 1))
        for i in range(count):
            day = date.fromordinal(first + (round(span * i / (count - 1)) if count > 1 else 0))
            anchor = "n" if 0 < i < count - 1 or count == 1 else ("nw" if i == 0 else "ne")
            self.create_text(xpos(day), y1 + 7, text=day.isoformat(), anchor=anchor,
                             font=self.f_small, fill=MUTED)
        self.create_line(x0, y1, x1, y1, fill=MUTED, width=1)

        for cat, points in self.series:
            color = CATEGORY_COLORS.get(cat, DEFAULT_CATEGORY_COLOR)
            if len(points) > 1:
                coords = [c for d, v, _e in points for c in (xpos(d), ypos(v))]
                self.create_line(*coords, fill=color, width=2, capstyle="round", joinstyle="round")
            for d, v, changed in points:
                if not changed:
                    continue
                px, py = xpos(d), ypos(v)
                dot = self.create_oval(px - 4, py - 4, px + 4, py + 4, fill=color,
                                       outline=SURFACE, width=2)
                detail = fit_text(self.f_small, f"{cat} · {d.isoformat()}: {v:g} {unit}", self.hint_room)
                self.tag_bind(dot, "<Enter>", lambda _e, t=detail: self.itemconfigure(self.hint, text=t))
                self.tag_bind(dot, "<Leave>", lambda _e: self.itemconfigure(
                    self.hint, text=fit_text(self.f_small, self.base_hint, self.hint_room)))


class CategoryLegend(tk.Canvas if HAVE_TK else object):
    """Wrapping row of colored swatches naming the categories in the line graphs."""

    ROW_H = 20

    def __init__(self, parent):
        super().__init__(parent, bg=SURFACE, bd=0, highlightthickness=0, height=24)
        self.categories, self.width_seen = [], 0
        self.f_small = APP_FONTS["small"]
        self.bind("<Configure>", self._on_configure)

    def retheme(self):
        self.configure(bg=SURFACE)
        self.redraw()

    def set_categories(self, categories):
        self.categories = list(categories)
        self.redraw()

    def _on_configure(self, event):
        if event.width != self.width_seen:  # ignore the height changes redraw() causes
            self.redraw()

    def redraw(self):
        self.delete("all")
        w = self.winfo_width()
        if w < 60:
            return
        self.width_seen = w
        x, y = 2, 2
        for cat in self.categories:
            need = 16 + self.f_small.measure(cat) + 18
            if x + need > w and x > 2:  # wrap to the next row
                x, y = 2, y + self.ROW_H
            color = CATEGORY_COLORS.get(cat, DEFAULT_CATEGORY_COLOR)
            self.create_rectangle(x, y + 5, x + 10, y + 15, fill=color, outline="")
            self.create_text(x + 16, y + 10, text=cat, anchor="w", font=self.f_small, fill=TEXT)
            x += need
        height = y + self.ROW_H + 2
        if int(float(self.cget("height"))) != height:
            self.configure(height=height)


