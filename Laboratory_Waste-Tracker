def make_swatch(master, color, size=14):
    """Build a small filled-circle image used as a colored category marker."""
    img = tk.PhotoImage(master=master, width=size, height=size)
    r = size / 2
    for y in range(size):
        half = max(r * r - (y + 0.5 - r) ** 2, 0) ** 0.5
        x0, x1 = int(round(r - half)), int(round(r + half))
        if x1 > x0:
            img.put(color, to=(x0, y, x1, y + 1))
    return img


