def walk_widgets(widget):
    """Every widget below `widget`, depth first."""
    for child in widget.winfo_children():
        yield child
        yield from walk_widgets(child)


_SYSTEM_FONT = {}


def pick_font_family(root, dyslexic=False):
    """Choose the interface font. Returns (family, matched); matched is False when a
    dyslexia-friendly font was asked for but none is installed."""
    available = set(tkfont.families(root))
    # Remember the system default before we ever change it, as the last resort
    _SYSTEM_FONT.setdefault("family", tkfont.nametofont("TkDefaultFont").actual("family"))
    normal = next((f for f in FONT_CANDIDATES if f in available), _SYSTEM_FONT["family"])
    if not dyslexic:
        return normal, True
    friendly = next((f for f in DYSLEXIC_FONT_CANDIDATES if f in available), None)
    return (friendly, True) if friendly else (normal, False)


def mix_colors(c1, c2, t):
    """Blend two '#rrggbb' colors: t=0 gives c1, t=1 gives c2."""
    a = [int(c1[i:i + 2], 16) for i in (1, 3, 5)]
    b = [int(c2[i:i + 2], 16) for i in (1, 3, 5)]
    return "#" + "".join(f"{round(x + (y - x) * t):02x}" for x, y in zip(a, b))


def ease_out(t):
    return 1 - (1 - t) ** 3


