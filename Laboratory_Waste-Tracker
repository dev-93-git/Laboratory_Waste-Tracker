#!/usr/bin/env python3
"""Laboratory Waste Tracker.

Logs hazardous and non-hazardous lab waste containers, tracks whether each one
is still stored or has been disposed of, summarizes totals, and charts the share
of records by waste type (all records, awaiting disposal, and disposed). Running
totals over time get their own line graphs: total, awaiting disposal and disposed,
each shown separately for hazardous and non-hazardous waste.

Two interfaces in one file, sharing the same data:
  python3 waste_tracker.py          open the desktop window (tkinter)
  python3 waste_tracker.py --cli    use the text menu in the terminal

If a window can't be opened (tkinter not installed, or no display), the program
falls back to the text menu automatically.

The window has a Settings menu: light / dark / high-contrast theme, export of the
summary or of all charted data to an .xlsx spreadsheet, a dyslexia-friendly font
toggle, and a switch to turn the click and tab animations off.

Uses only the Python standard library. Data is saved to waste_log.tsv and the
Settings choices to waste_settings.json, both next to this script.
"""

import argparse
import json
import math
import os
import re
import sys
import zipfile
from datetime import date, datetime

try:
    import tkinter as tk
    from tkinter import font as tkfont
    from tkinter import filedialog, messagebox, simpledialog, ttk
    HAVE_TK = True
except ImportError:  # tkinter is optional; the text menu still works without it
    tk = tkfont = filedialog = messagebox = simpledialog = ttk = None
    HAVE_TK = False

DATA_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "waste_log.tsv")
SETTINGS_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "waste_settings.json")

CATEGORIES = [
    "Halogenated solvent",
    "Non-halogenated solvent",
    "Acid",
    "Base",
    "Heavy metal",
    "Oxidizer",
    "Aqueous/other chemical",
    "Biological",
    "Sharps",
    "Radioactive",
    "Solid chemical-contaminated",
    "Non-hazardous",
]
UNITS = ["L", "mL", "kg", "g", "mg", "mol", "items"]
FIELDS = [
    "id", "date", "category", "description", "quantity",
    "unit", "location", "status", "disposed_date", "notes",
]


# =========================================================== shared data layer
def clean(text):
    """Strip characters that would break the tab-separated file."""
    return text.replace("\t", " ").replace("\n", " ").replace("\r", " ").strip()


def load():
    entries = []
    if not os.path.exists(DATA_FILE):
        return entries
    with open(DATA_FILE, encoding="utf-8") as f:
        for line in f:
            line = line.rstrip("\n")
            if not line:
                continue
            parts = line.split("\t")
            parts += [""] * (len(FIELDS) - len(parts))
            entry = dict(zip(FIELDS, parts))
            try:
                entry["id"] = int(entry["id"])
                entry["quantity"] = float(entry["quantity"])
            except ValueError:
                continue  # skip malformed rows
            entries.append(entry)
    return entries


def save(entries):
    with open(DATA_FILE, "w", encoding="utf-8") as f:
        for e in entries:
            row = [f"{e[k]:g}" if k == "quantity" else str(e[k]) for k in FIELDS]
            f.write("\t".join(row) + "\n")


def valid_date(text):
    try:
        datetime.strptime(text, "%Y-%m-%d")
        return True
    except ValueError:
        return False


def build_entry(entries, entry_date, category, description, quantity, unit,
                location, notes):
    """Validate values. Returns (entry, None) or (None, error message)."""
    entry_date, description = clean(entry_date), clean(description)
    if not valid_date(entry_date):
        return None, "Date must be in YYYY-MM-DD format."
    if category not in CATEGORIES:
        return None, "Please choose a waste category."
    if not description:
        return None, "Please describe the contents of the container."
    try:
        qty = float(quantity)
    except ValueError:
        qty = 0
    if qty <= 0:
        return None, "Quantity must be a number greater than zero."
    if unit not in UNITS:
        return None, "Please choose a unit."
    new_id = max((e["id"] for e in entries), default=0) + 1
    return {
        "id": new_id, "date": entry_date, "category": category,
        "description": description, "quantity": qty, "unit": unit,
        "location": clean(location), "status": "stored", "disposed_date": "",
        "notes": clean(notes),
    }, None


def filter_entries(entries, status="all", category="All", search=""):
    search = search.strip().lower()
    rows = []
    for e in entries:
        if status != "all" and e["status"] != status:
            continue
        if category != "All" and e["category"] != category:
            continue
        if search and search not in " ".join(
            (e["description"], e["location"], e["notes"])
        ).lower():
            continue
        rows.append(e)
    return rows


# Sort choices for the waste log: label -> (field, reverse)
SORT_OPTIONS = {
    "Entry order": ("id", False),
    "Alphabetical (A-Z)": ("description", False),
    "Alphabetical (Z-A)": ("description", True),
    "Waste type (A-Z)": ("category", False),
    "Waste type (Z-A)": ("category", True),
}


def sort_entries(rows, key="id", reverse=False):
    """Sort records by one field. Text sorts case-insensitively; ties fall back to
    contents, then ID, so entries of the same waste type stay in alphabetical order."""
    numeric = key in ("id", "quantity")

    def sort_key(e):
        primary = e[key] if numeric else str(e[key]).lower()
        return (primary, e["description"].lower(), e["id"])

    return sorted(rows, key=sort_key, reverse=reverse)


# ---- Totals over time (line graphs) -------------------------------------------
# Quantities can only be added within one kind of unit, so the graphs show one
# measure at a time. label: (noun, display unit, {unit: factor to the display unit})
MEASURES = {
    "Volume (L)": ("volume", "L", {"L": 1.0, "mL": 0.001}),
    "Mass (g)": ("mass", "g", {"kg": 1000.0, "g": 1.0, "mg": 0.001}),
    "Amount (mol)": ("amount", "mol", {"mol": 1.0}),
    "Items (count)": ("item", "items", {"items": 1.0}),
}

# The line graphs: one per (waste group, status), so six in all.
# Statuses use the same filters as the pie charts: (title, status filter)
LINE_STATUSES = [
    ("Total logged", None),
    ("Awaiting disposal", "stored"),
    ("Disposed", "disposed"),
]
# Everything except the "Non-hazardous" category counts as hazardous waste
WASTE_GROUPS = ["Hazardous", "Non-hazardous"]
LINE_EMPTY = {
    None: "No {group} {noun} records yet",
    "stored": "No {group} {noun} awaiting disposal",
    "disposed": "No {group} {noun} disposed of yet",
}


def waste_group(category):
    """'Non-hazardous' for the non-hazardous category, otherwise 'Hazardous'."""
    return "Non-hazardous" if category == "Non-hazardous" else "Hazardous"


def _parse_day(text):
    try:
        return datetime.strptime(text, "%Y-%m-%d").date()
    except (ValueError, TypeError):
        return None


def waste_timeline(entries, measure, status=None, group=None):
    """Running total of waste per category over time, in one measure's unit.

    status None       -> cumulative amount logged
    status "disposed" -> cumulative amount disposed of (by disposal date)
    status "stored"   -> amount awaiting disposal: logged minus disposed, so it
                         rises when waste is logged and falls when it is disposed of

    group None -> every category; "Hazardous" / "Non-hazardous" -> only that group.

    Records in other unit families are ignored. Returns (dates, series): dates is
    every day with activity; series is [(category, [(date, total, has_event)])] with
    one point per date, biggest final total first. has_event marks the days that
    category actually changed (where the graph draws a dot)."""
    _noun, _unit, factors = MEASURES[measure]
    events = {}  # category -> {day: change in amount}

    def add(category, day, amount):
        by_day = events.setdefault(category, {})
        by_day[day] = by_day.get(day, 0.0) + amount

    for e in entries:
        if group and waste_group(e["category"]) != group:
            continue
        factor = factors.get(e["unit"])
        logged = _parse_day(e["date"])
        if factor is None or logged is None:
            continue
        amount = e["quantity"] * factor
        disposed = e["status"] == "disposed"
        gone = max(_parse_day(e["disposed_date"]) or logged, logged) if disposed else None
        if status == "disposed":
            if disposed:
                add(e["category"], gone, amount)
        else:
            add(e["category"], logged, amount)
            if status == "stored" and disposed:
                add(e["category"], gone, -amount)

    # Leave out categories that never actually held any waste (e.g. logged and
    # disposed of the same day, for the awaiting-disposal view)
    kept = {}
    for category, by_day in events.items():
        running, peak = 0.0, 0.0
        for d in sorted(by_day):
            running += by_day[d]
            peak = max(peak, round(running, 9))
        if peak > 0:
            kept[category] = by_day

    days = sorted({d for by_day in kept.values() for d in by_day})
    series = []
    for category, by_day in kept.items():
        running, points = 0.0, []
        for d in days:
            running += by_day.get(d, 0.0)
            points.append((d, max(0.0, round(running, 9)), d in by_day))
        series.append((category, points))
    series.sort(key=lambda s: (-s[1][-1][1], s[0]))
    return days, series


def nice_ticks(vmax, count=4):
    """Round axis tick values from 0 up to at least vmax, e.g. [0, 5, 10, 15]."""
    if vmax <= 0:
        return [0, 1]
    raw = vmax / count
    mag = 10 ** math.floor(math.log10(raw))
    step = next((m * mag for m in (1, 2, 2.5, 5, 10) if m * mag >= raw), 10 * mag)
    n = math.ceil(vmax / step - 1e-9)
    return [round(i * step, 10) for i in range(n + 1)]


def summarize(entries):
    """Returns sorted list of (category, unit, stored_total, disposed_total)."""
    totals = {}
    for e in entries:
        key = (e["category"], e["unit"])
        stored, disposed = totals.get(key, (0.0, 0.0))
        if e["status"] == "disposed":
            disposed += e["quantity"]
        else:
            stored += e["quantity"]
        totals[key] = (stored, disposed)
    return [(cat, unit, s, d) for (cat, unit), (s, d) in sorted(totals.items())]


# The three pie charts: (title, status filter, message shown when it has no records)
CHART_GROUPS = [
    ("All records", None, "No records yet"),
    ("Awaiting disposal", "stored", "Nothing awaiting disposal"),
    ("Disposed", "disposed", "Nothing disposed of yet"),
]


def category_counts(entries, status=None):
    """Number of records (containers) per waste category, biggest first.

    status: None = every record, "stored" = awaiting disposal, "disposed" = disposed.
    Returns [(category, count)]; categories with no records are left out."""
    counts = {}
    for e in entries:
        disposed = e["status"] == "disposed"
        if (status == "disposed" and not disposed) or (status == "stored" and disposed):
            continue
        counts[e["category"]] = counts.get(e["category"], 0) + 1
    return sorted(counts.items(), key=lambda kv: (-kv[1], kv[0]))


def pie_slices(counts):
    """Turn [(label, count)] into pie geometry [(label, count, percent, start, extent)].
    Angles are in degrees, clockwise from 12 o'clock, and the extents add up to 360."""
    total = sum(n for _, n in counts)
    slices, angle = [], 0.0
    for label, n in counts:
        extent = 360.0 * n / total
        slices.append((label, n, 100.0 * n / total, angle, extent))
        angle += extent
    return slices


def readable_text(color):
    """Dark or white text, whichever reads better on the given '#rrggbb' fill."""
    r, g, b = (int(color[i:i + 2], 16) for i in (1, 3, 5))
    return "#1E2A35" if 0.299 * r + 0.587 * g + 0.114 * b > 150 else "#FFFFFF"


# ================================================ spreadsheet export (.xlsx)
# A sheet is (title, header row, data rows). write_xlsx() builds a real Excel
# workbook with nothing but zipfile, so no extra packages are needed.
def summary_sheets(entries):
    """The Summary tab: totals per category and unit, and the three container counts."""
    table = [(cat, unit, stored, disposed, stored + disposed)
             for cat, unit, stored, disposed in summarize(entries)]
    pending = sum(1 for e in entries if e["status"] == "stored")
    return [
        ("Summary by category",
         ["Category", "Unit", "Awaiting disposal", "Disposed", "Total"], table),
        ("Container counts", ["Measure", "Containers"],
         [("Awaiting disposal", pending), ("Disposed", len(entries) - pending),
          ("Total containers", len(entries))]),
    ]


def charts_sheet(entries):
    """The three pie charts: containers per waste type and their share, side by side."""
    per_group = [dict(category_counts(entries, status)) for _t, status, _m in CHART_GROUPS]
    totals = [sum(g.values()) for g in per_group]
    seen = {c for g in per_group for c in g}
    cats = [c for c in CATEGORIES if c in seen] + sorted(seen - set(CATEGORIES))
    headers = ["Waste type"]
    for title, _status, _msg in CHART_GROUPS:
        headers += [f"{title} (containers)", f"{title} (%)"]
    rows = []
    for cat in cats:
        row = [cat]
        for counts, total in zip(per_group, totals):
            n = counts.get(cat, 0)
            row += [n, round(100.0 * n / total, 1) if total else 0]
        rows.append(tuple(row))
    return ("Share of records (pie)", headers, rows)


def trends_sheet(entries):
    """Every line graph, for every measure: one row per waste type and date."""
    rows = []
    for measure, (_noun, unit, _factors) in MEASURES.items():
        for group in WASTE_GROUPS:
            for title, status in LINE_STATUSES:
                _days, series = waste_timeline(entries, measure, status, group)
                for cat, points in series:
                    for day, value, _changed in points:
                        rows.append((measure, group, title, cat, day.isoformat(), value, unit))
    return ("Trends (line graphs)",
            ["Measure", "Waste group", "Graph", "Waste type", "Date", "Running total", "Unit"],
            rows)


_XML_BAD = re.compile(r"[\x00-\x08\x0b\x0c\x0e-\x1f]")


def _xml_text(value):
    text = _XML_BAD.sub("", str(value))
    return text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def _col_name(index):
    name, n = "", index + 1
    while n:
        n, rem = divmod(n - 1, 26)
        name = chr(65 + rem) + name
    return name


def _sheet_xml(headers, rows):
    table = [list(headers)] + [list(r) for r in rows]
    widths = [8] * len(headers)
    xml_rows = []
    for r, row in enumerate(table, 1):
        cells = []
        for c, value in enumerate(row):
            if value is None or value == "":
                continue
            ref = f"{_col_name(c)}{r}"
            style = ' s="1"' if r == 1 else ""
            if isinstance(value, (int, float)) and not isinstance(value, bool):
                cells.append(f'<c r="{ref}"{style}><v>{value:.10g}</v></c>')
                shown = f"{value:g}"
            else:
                cells.append(f'<c r="{ref}"{style} t="inlineStr"><is>'
                             f'<t xml:space="preserve">{_xml_text(value)}</t></is></c>')
                shown = str(value)
            if c < len(widths):
                widths[c] = max(widths[c], min(len(shown), 60))
        xml_rows.append(f'<row r="{r}">{"".join(cells)}</row>')
    cols = "".join(f'<col min="{i}" max="{i}" width="{w + 3}" customWidth="1"/>'
                   for i, w in enumerate(widths, 1))
    return ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
            '<worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">'
            '<sheetViews><sheetView workbookViewId="0">'
            '<pane ySplit="1" topLeftCell="A2" activePane="bottomLeft" state="frozen"/>'
            '</sheetView></sheetViews><sheetFormatPr defaultRowHeight="15"/>'
            f'<cols>{cols}</cols><sheetData>{"".join(xml_rows)}</sheetData></worksheet>')


def write_xlsx(path, sheets):
    """Write [(title, headers, rows), ...] to an .xlsx workbook, one worksheet each."""
    names = []
    for title, _h, _r in sheets:
        base = re.sub(r"[\[\]:*?/\\]", "-", title)[:31] or "Sheet"
        name, n = base, 2
        while name.lower() in (x.lower() for x in names):
            suffix = f" ({n})"
            name, n = base[:31 - len(suffix)] + suffix, n + 1
        names.append(name)
    main = "http://schemas.openxmlformats.org/spreadsheetml/2006/main"
    rel = "http://schemas.openxmlformats.org/officeDocument/2006/relationships"
    head = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
    count = len(sheets)

    content_types = (
        head + '<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">'
        '<Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>'
        '<Default Extension="xml" ContentType="application/xml"/>'
        '<Override PartName="/xl/workbook.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/>'
        '<Override PartName="/xl/styles.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.styles+xml"/>'
        + "".join(f'<Override PartName="/xl/worksheets/sheet{i}.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/>'
                  for i in range(1, count + 1))
        + "</Types>")
    root_rels = (
        head + '<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">'
        f'<Relationship Id="rId1" Type="{rel}/officeDocument" Target="xl/workbook.xml"/></Relationships>')
    workbook = (
        head + f'<workbook xmlns="{main}" xmlns:r="{rel}"><sheets>'
        + "".join(f'<sheet name="{_xml_text(n)}" sheetId="{i}" r:id="rId{i}"/>'
                  for i, n in enumerate(names, 1))
        + "</sheets></workbook>")
    workbook_rels = (
        head + '<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">'
        + "".join(f'<Relationship Id="rId{i}" Type="{rel}/worksheet" Target="worksheets/sheet{i}.xml"/>'
                  for i in range(1, count + 1))
        + f'<Relationship Id="rId{count + 1}" Type="{rel}/styles" Target="styles.xml"/></Relationships>')
    styles = (
        head + f'<styleSheet xmlns="{main}">'
        '<fonts count="2"><font><sz val="11"/><name val="Calibri"/></font>'
        '<font><b/><sz val="11"/><name val="Calibri"/></font></fonts>'
        '<fills count="3"><fill><patternFill patternType="none"/></fill>'
        '<fill><patternFill patternType="gray125"/></fill>'
        '<fill><patternFill patternType="solid"><fgColor rgb="FFCDEFEB"/><bgColor indexed="64"/></patternFill></fill></fills>'
        '<borders count="1"><border><left/><right/><top/><bottom/><diagonal/></border></borders>'
        '<cellStyleXfs count="1"><xf numFmtId="0" fontId="0" fillId="0" borderId="0"/></cellStyleXfs>'
        '<cellXfs count="2"><xf numFmtId="0" fontId="0" fillId="0" borderId="0" xfId="0"/>'
        '<xf numFmtId="0" fontId="1" fillId="2" borderId="0" xfId="0" applyFont="1" applyFill="1"/></cellXfs>'
        '<cellStyles count="1"><cellStyle name="Normal" xfId="0" builtinId="0"/></cellStyles></styleSheet>')

    with zipfile.ZipFile(path, "w", zipfile.ZIP_DEFLATED) as z:
        z.writestr("[Content_Types].xml", content_types)
        z.writestr("_rels/.rels", root_rels)
        z.writestr("xl/workbook.xml", workbook)
        z.writestr("xl/_rels/workbook.xml.rels", workbook_rels)
        z.writestr("xl/styles.xml", styles)
        for i, (_title, headers, rows) in enumerate(sheets, 1):
            z.writestr(f"xl/worksheets/sheet{i}.xml", _sheet_xml(headers, rows))


# ============================================================ text interface
def ask(label, default=""):
    suffix = f" [{default}]" if default else ""
    try:
        value = input(f"{label}{suffix}: ")
    except EOFError:
        print()
        sys.exit(0)
    value = clean(value)
    return value if value else default


def choose(label, options, default=None):
    for i, opt in enumerate(options, 1):
        print(f"  {i:>2}. {opt}")
    while True:
        raw = ask(label, str(default) if default else "")
        if raw.isdigit() and 1 <= int(raw) <= len(options):
            return options[int(raw) - 1]
        print(f"  Enter a number from 1 to {len(options)}.")


def ask_date(label, default):
    while True:
        raw = ask(label, default)
        if valid_date(raw):
            return raw
        print("  Use the format YYYY-MM-DD.")


def ask_quantity():
    while True:
        raw = ask("Quantity")
        try:
            qty = float(raw)
            if qty > 0:
                return qty
        except ValueError:
            pass
        print("  Enter a number greater than zero.")


def ask_id(entries, label):
    raw = ask(label)
    if raw.isdigit():
        for e in entries:
            if e["id"] == int(raw):
                return e
    print("  No entry with that ID.")
    return None


def print_table(rows):
    if not rows:
        print("  (no entries)")
        return
    header = f"{'ID':>4}  {'Date':<10}  {'Category':<27}  {'Qty':>8} {'Unit':<5}  {'Status':<8}  {'Location':<12}  Description"
    print(header)
    print("-" * len(header))
    for e in rows:
        print(
            f"{e['id']:>4}  {e['date']:<10}  {e['category']:<27}  "
            f"{e['quantity']:>8g} {e['unit']:<5}  {e['status']:<8}  "
            f"{e['location'][:12]:<12}  {e['description']}"
        )


def cli_add_entry(entries):
    print("\n-- Add waste entry --")
    entry_date = ask_date("Date", date.today().isoformat())
    print("Category:")
    category = choose("Choose category", CATEGORIES)
    description = ""
    while not description:
        description = ask("Description / contents (e.g. 'acetone, 10% ethanol')")
    quantity = ask_quantity()
    print("Unit:")
    unit = choose("Choose unit", UNITS, default=1)
    location = ask("Lab / location", "")
    notes = ask("Notes", "")
    entry, error = build_entry(entries, entry_date, category, description,
                               quantity, unit, location, notes)
    if error:
        print(f"  {error}")
        return
    entries.append(entry)
    save(entries)
    print(f"Saved entry #{entry['id']}.")


def cli_list_entries(entries):
    print("\n-- List entries --")
    print("Filter by status:")
    status = choose("Choose", ["all", "stored", "disposed"], default=1)
    print("Filter by category (or 'All'):")
    cat = choose("Choose", ["All"] + CATEGORIES, default=1)
    print("Sort by:")
    order = choose("Choose", list(SORT_OPTIONS), default=1)
    key, reverse = SORT_OPTIONS[order]
    print()
    print_table(sort_entries(filter_entries(entries, status, cat), key, reverse))


def cli_summary(entries):
    print("\n-- Summary by category --")
    rows = summarize(entries)
    if not rows:
        print("  (no entries)")
        return
    header = f"{'Category':<27}  {'Unit':<5}  {'Stored':>10}  {'Disposed':>10}"
    print(header)
    print("-" * len(header))
    for cat, unit, stored, disposed in rows:
        print(f"{cat:<27}  {unit:<5}  {stored:>10g}  {disposed:>10g}")
    open_count = sum(1 for e in entries if e["status"] == "stored")
    print(f"\n{open_count} of {len(entries)} containers are still awaiting disposal.")


def cli_mark_disposed(entries):
    print("\n-- Mark entry as disposed --")
    pending = [e for e in entries if e["status"] == "stored"]
    print_table(pending)
    if not pending:
        return
    e = ask_id(entries, "Entry ID to mark disposed")
    if e is None:
        return
    if e["status"] == "disposed":
        print("  That entry is already marked disposed.")
        return
    e["disposed_date"] = ask_date("Disposal date", date.today().isoformat())
    e["status"] = "disposed"
    save(entries)
    print(f"Entry #{e['id']} marked disposed.")


def cli_delete_entry(entries):
    print("\n-- Delete entry --")
    print_table(entries)
    if not entries:
        return
    e = ask_id(entries, "Entry ID to delete")
