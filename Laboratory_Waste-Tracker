        return
    if ask(f"Delete entry #{e['id']} ({e['description']})? y/N", "n").lower() != "y":
        print("Cancelled.")
        return
    entries.remove(e)
    save(entries)
    print("Deleted.")


def cli_charts(entries):
    print("\n-- Share of records by waste type --")
    for title, status, empty_text in CHART_GROUPS:
        slices = pie_slices(category_counts(entries, status))
        total = sum(s[1] for s in slices)
        print(f"\n{title}  ({total} record{'s' if total != 1 else ''})")
        if not slices:
            print(f"  {empty_text}")
            continue
        for cat, n, pct, _start, _extent in slices:
            bar = "#" * max(1, round(pct / 100 * 30))
            print(f"  {cat:<27} {n:>4}  {pct:>5.1f}%  {bar}")


def cli_trends(entries):
    print("\n-- Waste totals over time --")
    print("Measure:")
    measure = choose("Choose", list(MEASURES), default=1)
    noun, unit, _factors = MEASURES[measure]
    for group in WASTE_GROUPS:
        for title, status in LINE_STATUSES:
            _days, series = waste_timeline(entries, measure, status, group)
            print(f"\n{group} · {title}  [{measure}]")
