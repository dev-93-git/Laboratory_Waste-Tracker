        self.font_family = family
        apply_theme(self.root, self.settings["theme"], family)
        # Colored category dots (the "other" color changes with the theme)
        self.swatches = {cat: make_swatch(self.root, CATEGORY_COLORS.get(cat, DEFAULT_CATEGORY_COLOR))
                         for cat in CATEGORIES}
        self.default_swatch = make_swatch(self.root, DEFAULT_CATEGORY_COLOR)
        self.form_swatch.configure(bg=SURFACE)
        self._update_form_swatch()
        for tree in (self.tree, self.summary_tree):
            tree.tag_configure("odd", background=SURFACE_ALT)
        self.tree.tag_configure("disposed", foreground=MUTED)
        for chart in self.charts + self.line_charts:
            chart.retheme()
        self.trend_legend.retheme()
        self._style_menus()
        # Dropdown lists of comboboxes are created on first use, so restyle them directly
        for widget in walk_widgets(self):
            if isinstance(widget, ttk.Combobox):
                try:
                    popdown = self.root.tk.eval(f"ttk::combobox::PopdownWindow {widget}")
                    self.root.tk.call(f"{popdown}.f.l", "configure",
                                      "-background", SURFACE, "-foreground", TEXT,
                                      "-selectbackground", SELECT, "-selectforeground", SELECT_TEXT)
                except tk.TclError:
                    pass
        self.refresh()
        return matched

    def on_theme_change(self):
        self.settings["theme"] = self.v_theme.get()
        self._restyle()
        save_settings(self.settings)

    def on_dyslexic_toggle(self):
        self.settings["dyslexic_font"] = self.v_dyslexic.get()
        matched = self._restyle()
        if self.settings["dyslexic_font"]:
            if not matched:
                self.settings["dyslexic_font"] = False
                self.v_dyslexic.set(False)
                messagebox.showinfo(
                    "Font not installed",
                    "No dyslexia-friendly font was found on this computer.\n\n"
                    "Install OpenDyslexic (opendyslexic.org), Lexend or Atkinson Hyperlegible, "
                    "then turn this option on again.")
            elif not self.font_family.startswith("OpenDyslexic"):
                messagebox.showinfo(
                    "Using " + self.font_family,
                    f"OpenDyslexic is not installed, so the program is using {self.font_family} "
                    "instead. Install OpenDyslexic (opendyslexic.org) to use it automatically.")
        save_settings(self.settings)

    def on_animation_toggle(self):
        self.settings["animations"] = not self.v_no_anim.get()
        save_settings(self.settings)

    # ----------------------------------------------------------- animations
    def _bind_button_animation(self):
        for widget in walk_widgets(self):
            if isinstance(widget, ttk.Button):
                widget.bind("<ButtonPress-1>", self._on_button_press, add="+")

    def _on_button_press(self, event):
        """Click feedback: the button flashes a stronger shade and eases back."""
        if not self.settings["animations"]:
            return
        button = event.widget
        try:
            if str(button.cget("state")) == "disabled":
                return
            key = str(button)
            base = self._flash_base.setdefault(key, button.cget("style") or "TButton")
            name = self._flash_style.setdefault(key, f"Flash{len(self._flash_style)}.{base}")
            style = ttk.Style(self.root)
            rest = style.lookup(base, "background") or SURFACE
            flash = mix_colors(rest, TEXT, 0.28)
            if key in self._flash_jobs:
                button.after_cancel(self._flash_jobs.pop(key))
        except tk.TclError:
            return
        steps = 9

        def step(i):
            try:
                color = mix_colors(flash, rest, ease_out(i / steps))
                style.configure(name, background=color, lightcolor=color, darkcolor=color)
                state_colors = [("pressed", color), ("active", color)]
                style.map(name, background=state_colors, lightcolor=state_colors,
                          darkcolor=state_colors)
                if i == 0:
                    button.configure(style=name)
                if i < steps:
                    self._flash_jobs[key] = button.after(24, step, i + 1)
                else:
                    button.configure(style=base)
                    self._flash_jobs.pop(key, None)
            except tk.TclError:  # window closed mid-animation
                self._flash_jobs.pop(key, None)

        step(0)

    def _on_tab_changed(self, _event=None):
        """Tab switch: a curtain in the window color wipes away to reveal the new tab."""
        if not (self._ready and self.settings["animations"]):
            return
        if self._wipe_job:
            self.after_cancel(self._wipe_job)
            self._wipe_job = None
        if self._wipe is not None:
            self._wipe.destroy()
            self._wipe = None
        self.notebook.update_idletasks()
        page = self.notebook.nametowidget(self.notebook.select())
        x, y, w, h = page.winfo_x(), page.winfo_y(), page.winfo_width(), page.winfo_height()
        if w < 50 or h < 50:
            return
        cover = self._wipe = tk.Frame(self.notebook, bg=BG, bd=0, highlightthickness=0)
        steps = 12

        def step(i):
            if i >= steps:
                cover.destroy()
                self._wipe = self._wipe_job = None
                return
            width = max(1, round(w * (1 - ease_out(i / steps))))
            cover.place(x=x + w - width, y=y, width=width, height=h)
            cover.lift()
            self._wipe_job = self.after(16, step, i + 1)

        step(0)

    # ----------------------------------------------------------- exports
    def export_summary(self):
        self._export("Export summary", f"waste_summary_{date.today().isoformat()}.xlsx",
                     summary_sheets(self.entries))

    def export_all(self):
        sheets = (summary_sheets(self.entries)
                  + [charts_sheet(self.entries), trends_sheet(self.entries)])
        self._export("Export all visualized data",
                     f"waste_data_{date.today().isoformat()}.xlsx", sheets)

    def _export(self, title, default_name, sheets):
        if not self.entries:
            messagebox.showinfo("Nothing to export", "No waste has been logged yet.")
            return
        path = filedialog.asksaveasfilename(
            parent=self.root, title=title, initialfile=default_name,
            defaultextension=".xlsx", filetypes=[("Excel workbook", "*.xlsx")])
        if not path:
            return
        try:
            write_xlsx(path, sheets)
        except OSError as exc:
            messagebox.showerror("Could not export", f"Failed to write {path}:\n{exc}")
            return
        messagebox.showinfo("Export complete", f"Saved to:\n{path}")

    # ----------------------------------------------------------- actions
    def add_entry(self):
        entry, error = build_entry(
            self.entries, self.v_date.get(), self.v_category.get(), self.v_desc.get(),
            self.v_qty.get(), self.v_unit.get(), self.v_location.get(), self.v_notes.get(),
        )
        if error:
            messagebox.showwarning("Check the form", error)
            return
        self.entries.append(entry)
        self._save_and_refresh()
        self.clear_form(keep_context=True)
        self.status.set(f"Saved entry #{entry['id']}  ·  " + self.status.get())

    def clear_form(self, keep_context=False):
        self.v_desc.set("")
        self.v_qty.set("")
        self.v_notes.set("")
        if not keep_context:
            self.v_date.set(date.today().isoformat())
            self.v_category.set(CATEGORIES[0])
            self.v_unit.set(UNITS[0])
            self.v_location.set("")
            self._update_form_swatch()
        self.desc_entry.focus_set()

    def _swatch(self, category):
        return self.swatches.get(category, self.default_swatch)

    def _update_form_swatch(self):
        self.form_swatch.configure(image=self._swatch(self.v_category.get()))

    def _selected_entries(self):
        ids = {int(self.tree.set(item, "id")) for item in self.tree.selection()}
        return [e for e in self.entries if e["id"] in ids]

    def mark_disposed(self):
        chosen = [e for e in self._selected_entries() if e["status"] == "stored"]
        if not chosen:
            messagebox.showinfo("Nothing to do", "Select one or more stored entries first.")
            return
        when = simpledialog.askstring(
            "Disposal date", f"Disposal date for {len(chosen)} entr{'y' if len(chosen) == 1 else 'ies'} (YYYY-MM-DD):",
            initialvalue=date.today().isoformat(), parent=self.root)
        if when is None:
            return
        when = clean(when)
        if not valid_date(when):
            messagebox.showwarning("Invalid date", "Date must be in YYYY-MM-DD format.")
            return
        for e in chosen:
            e["status"], e["disposed_date"] = "disposed", when
        self._save_and_refresh()

    def delete_selected(self):
        chosen = self._selected_entries()
        if not chosen:
            messagebox.showinfo("Nothing selected", "Select one or more entries to delete.")
            return
        if not messagebox.askyesno(
                "Delete entries",
                f"Permanently delete {len(chosen)} entr{'y' if len(chosen) == 1 else 'ies'}?",
                icon="warning"):
            return
        gone = {e["id"] for e in chosen}
        self.entries = [e for e in self.entries if e["id"] not in gone]
        self._save_and_refresh()

    def sort_by(self, key):
        """Column-heading click: sort by that column, click again to reverse."""
        if self.sort_key == key:
            self.sort_reverse = not self.sort_reverse
        else:
            self.sort_key, self.sort_reverse = key, False
        # Keep the Sort dropdown in step with what the table is actually doing
        self.f_sort.set(next((name for name, spec in SORT_OPTIONS.items()
                              if spec == (self.sort_key, self.sort_reverse)),
                             "Sorted by column"))
        self.refresh()

    def _on_sort_choice(self, _event=None):
        self.sort_key, self.sort_reverse = SORT_OPTIONS[self.f_sort.get()]
        self.refresh()

    def _save_and_refresh(self):
        try:
            save(self.entries)
        except OSError as exc:
            messagebox.showerror("Could not save", f"Failed to write {DATA_FILE}:\n{exc}")
        self.refresh()

    # ----------------------------------------------------------- display
    def refresh(self):
        rows = filter_entries(self.entries, self.f_status.get(),
                              self.f_category.get(), self.f_search.get())
        rows = sort_entries(rows, self.sort_key, self.sort_reverse)

        self.tree.delete(*self.tree.get_children())
        for i, e in enumerate(rows):
            values = []
            for key, *_ in TREE_COLUMNS:
                if key == "quantity":
                    values.append(f"{e[key]:g}")
                elif key == "status":
                    values.append(STATUS_LABEL.get(e[key], e[key]))
                else:
                    values.append(e[key])
            tags = (["odd"] if i % 2 else []) + (["disposed"] if e["status"] == "disposed" else [])
            self.tree.insert("", "end", values=values, tags=tags,
                             image=self._swatch(e["category"]))

        # Friendly empty state
        if rows:
            self.empty_label.place_forget()
        else:
            self.empty_label.config(
                text="No entries match your filters." if self.entries
                else "No waste logged yet.\nAdd your first container using the form on the left.")
            self.empty_label.place(in_=self.tree, relx=0.5, rely=0.42, anchor="center")

        self.summary_tree.delete(*self.summary_tree.get_children())
        for i, (cat, unit, stored, disposed) in enumerate(summarize(self.entries)):
            self.summary_tree.insert("", "end", values=(cat, unit, f"{stored:g}", f"{disposed:g}"),
                                     tags=("odd",) if i % 2 else (),
                                     image=self._swatch(cat))

        for chart in self.charts:
            chart.set_entries(self.entries)

        shown = set()
        for chart in self.line_charts:
            chart.set_data(self.entries, self.f_measure.get())
            shown.update(cat for cat, _points in chart.series)
        self.trend_legend.set_categories(
            [c for c in CATEGORIES if c in shown] + sorted(shown - set(CATEGORIES)))

        pending = sum(1 for e in self.entries if e["status"] == "stored")
        self.stat_pending.set(str(pending))
        self.stat_disposed.set(str(len(self.entries) - pending))
        self.stat_total.set(str(len(self.entries)))
        self.status.set(f"Showing {len(rows)} of {len(self.entries)} entries  ·  {pending} awaiting disposal")


def run_gui():
    """Open the window. Returns False if it could not be opened."""
    enable_hidpi()
    try:
        root = tk.Tk()
    except tk.TclError as exc:  # e.g. no display available
        print(f"Could not open a window ({exc}).")
        return False
    WasteTrackerApp(root)
    root.mainloop()
    return True


# ================================================================== entry point
def main(argv=None):
    parser = argparse.ArgumentParser(description="Laboratory Waste Tracker")
    parser.add_argument("--cli", action="store_true",
                        help="use the text menu in the terminal instead of the window")
    args = parser.parse_args(argv)

    if not args.cli:
        if not HAVE_TK:
            print("tkinter is not installed, so the window can't open. Using the text menu.")
        elif run_gui():
            return
        print("Falling back to the text menu (use --cli to skip the window next time).")
    run_cli()


if __name__ == "__main__":
    main()
